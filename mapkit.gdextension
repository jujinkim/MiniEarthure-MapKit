[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]
linux.debug.x86_64 = "target/debug/libmapkit_godot.so"
linux.release.x86_64 = "target/release/libmapkit_godot.so"
windows.debug.x86_64 = "target/debug/mapkit_godot.dll"
windows.release.x86_64 = "target/release/mapkit_godot.dll"
android.debug.arm64 = "target/aarch64-linux-android/debug/libmapkit_godot.so"
android.release.arm64 = "target/aarch64-linux-android/release/libmapkit_godot.so"
