{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PackageManifest",
  "type": "object",
  "required": [
    "assets",
    "attributions",
    "bounds",
    "cell_size_cm",
    "document",
    "files",
    "format",
    "format_version",
    "generated_version",
    "map_id",
    "provenance",
    "recipe_version",
    "revision",
    "seed",
    "theme",
    "world_content_hash"
  ],
  "properties": {
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Asset"
      }
    },
    "attributions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Attribution"
      }
    },
    "bounds": {
      "$ref": "#/definitions/Bounds"
    },
    "cell_size_cm": {
      "type": "integer",
      "format": "uint32",
      "maximum": 102400.0,
      "minimum": 200.0
    },
    "document": {
      "type": "string",
      "pattern": "^document\\.json$"
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/FileRecord"
      },
      "maxItems": 8192,
      "minItems": 1
    },
    "format": {
      "type": "string",
      "pattern": "^memap$"
    },
    "format_version": {
      "type": "integer",
      "format": "uint32",
      "maximum": 1.0,
      "minimum": 1.0
    },
    "generated_version": {
      "type": "integer",
      "format": "uint32",
      "maximum": 6.0,
      "minimum": 6.0
    },
    "map_id": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1
    },
    "provenance": {
      "$ref": "#/definitions/Provenance"
    },
    "recipe_version": {
      "type": "integer",
      "format": "uint32",
      "maximum": 1.0,
      "minimum": 1.0
    },
    "revision": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "seed": {
      "type": "integer",
      "format": "uint64",
      "maximum": 9007199254740991.0,
      "minimum": 0.0
    },
    "theme": {
      "type": "string",
      "pattern": "^default$"
    },
    "world_content_hash": {
      "type": "string",
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Asset": {
      "type": "object",
      "required": [
        "attribution",
        "collision",
        "id",
        "path"
      ],
      "properties": {
        "attribution": {
          "$ref": "#/definitions/Attribution"
        },
        "collision": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CollisionBox"
          }
        },
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Attribution": {
      "type": "object",
      "required": [
        "license",
        "notice",
        "source"
      ],
      "properties": {
        "license": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "notice": {
          "description": "May be empty; multiline notices are preserved without normalization.",
          "type": "string"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    },
    "Bounds": {
      "type": "object",
      "required": [
        "max",
        "min"
      ],
      "properties": {
        "max": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int64"
          },
          "maxItems": 2,
          "minItems": 2
        },
        "min": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int64"
          },
          "maxItems": 2,
          "minItems": 2
        }
      },
      "additionalProperties": false
    },
    "CollisionBox": {
      "type": "object",
      "required": [
        "center",
        "size_cm"
      ],
      "properties": {
        "center": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int64"
          },
          "maxItems": 3,
          "minItems": 3
        },
        "size_cm": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint32",
            "minimum": 0.0
          },
          "maxItems": 3,
          "minItems": 3
        }
      },
      "additionalProperties": false
    },
    "FileRecord": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "size"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "format": "uint64",
          "maximum": 134217728.0,
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "Provenance": {
      "type": "object",
      "required": [
        "build_id",
        "fingerprint",
        "first_created",
        "last_edited",
        "tool_id",
        "version"
      ],
      "properties": {
        "build_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "fingerprint": {
          "description": "Untrusted producer label; never authentication or an allowlist key.",
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "first_created": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])[Tt]([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?([Zz]|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
        },
        "last_edited": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])[Tt]([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?([Zz]|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
        },
        "tool_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    }
  }
}